# GeoAICubes API — CPU-only; install with uv from repo root build context.
# GeoDataCube Zarrs are not baked into the image: Compose bind-mounts host ../data:/data:ro
# (see deploy/docker-compose.yml and docs/demo-config.md).
FROM python:3.12-slim-bookworm

# Rasterio/TiTiler wheels expect GDAL and expat at runtime (not bundled in slim).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libexpat1 libgdal32 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY src ./src

ENV UV_LINK_MODE=copy
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "geoaicubes.api.main:app", "--host", "0.0.0.0", "--port", "8000"]