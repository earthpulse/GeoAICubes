# MinIO (Compose service; dev-only credentials — never commit real secrets)
MINIO_ROOT_USER=geoaicubes
MINIO_ROOT_PASSWORD=geoaicubes-dev-only
MINIO_BUCKET=data
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# Library / API S3 settings (nested env for src/geoaicubes/config.py — Step 1)
# Native API/UI → host MinIO (make minio-up). Compose overrides to http://minio:9000 in docker-compose.yml.
GEOAICUBES_STORAGE__ENDPOINT_URL=http://localhost:9000
GEOAICUBES_STORAGE__BUCKET=data
GEOAICUBES_STORAGE__PREFIX=GEODATACUBE_ZARR_openEO
GEOAICUBES_STORAGE__ACCESS_KEY_ID=geoaicubes
GEOAICUBES_STORAGE__SECRET_ACCESS_KEY=geoaicubes-dev-only
GEOAICUBES_STORAGE__REGION=us-east-1
GEOAICUBES_STORAGE__USE_SSL=false
# filesystem (native dev) or s3 (Compose API against MinIO)
GEOAICUBES_STORAGE__DISCOVERY_MODE=filesystem
GEOAICUBES_STORAGE__LOCAL_ROOT=data/GEODATACUBE_ZARR_openEO

GEOAICUBES_API_PORT=8000
GEOAICUBES_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

VITE_API_BASE_URL=http://localhost:8000