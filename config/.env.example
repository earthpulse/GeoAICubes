# GeoAICubes scaffold environment variables (Step 0).
# Copy to config/.env (gitignored) and adjust for local runs.
# Authoritative names: docs/scaffold.md | Compose defaults: deploy/COMPOSE.md
#
# Dev-only placeholders — not for production.
# Makefile `compose-up` uses this file: docker compose --env-file config/.env.example
#
# Host `uv run` (no Compose): use paths.data_root `data`, storage endpoint
# http://localhost:9000 — see commented alternates below.

# =============================================================================
# MinIO (Compose `minio` + `minio-init`; align with GEOAICUBES_STORAGE__*)
# =============================================================================
MINIO_ROOT_USER=geoaicubes
MINIO_ROOT_PASSWORD=geoaicubes-dev-only
MINIO_BUCKET=geoaicubes-demo
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
# MINIO_ENDPOINT=http://minio:9000  # minio-init only; fixed in deploy/docker-compose.yml

# =============================================================================
# Demo config overrides (GEOAICUBES_*; nested keys use __)
# Baseline values live in config/demo.yaml — uncomment to override.
# =============================================================================

# --- Identity & API metadata ---
# GEOAICUBES_NAME=geoaicubes-demo
# GEOAICUBES_CRS=EPSG:4326
# GEOAICUBES_API_BASE_URL=http://localhost:8000

# --- AOI (WGS84 bbox) ---
# GEOAICUBES_BBOX__MIN_LON=2.35
# GEOAICUBES_BBOX__MIN_LAT=41.75
# GEOAICUBES_BBOX__MAX_LON=2.55
# GEOAICUBES_BBOX__MAX_LAT=41.95

# --- Cube period ---
# GEOAICUBES_DATES__START=2019-01-01
# GEOAICUBES_DATES__END=2021-12-31

# --- Data paths (under paths.data_root) ---
# Host dev: GEOAICUBES_PATHS__DATA_ROOT=data
GEOAICUBES_PATHS__DATA_ROOT=/app/data
# GEOAICUBES_PATHS__CUBE_ZARR=geodatacubes/montseny-demo.zarr
# GEOAICUBES_PATHS__LABEL_RASTER=cobertes-sol/labels/montseny_labels.tif
# GEOAICUBES_PATHS__CLASSIFICATION_OUTPUT=derived/classification_montseny.tif
# GEOAICUBES_PATHS__CHANGE_MAP_OUTPUT=derived/change_map_montseny.tif

# --- S3 storage (MinIO or remote) ---
# Host dev: GEOAICUBES_STORAGE__ENDPOINT_URL=http://localhost:9000
GEOAICUBES_STORAGE__ENDPOINT_URL=http://minio:9000
GEOAICUBES_STORAGE__BUCKET=geoaicubes-demo
GEOAICUBES_STORAGE__PREFIX=montseny/
GEOAICUBES_STORAGE__REGION=us-east-1
GEOAICUBES_STORAGE__USE_SSL=false
GEOAICUBES_STORAGE__ACCESS_KEY_ID=geoaicubes
GEOAICUBES_STORAGE__SECRET_ACCESS_KEY=geoaicubes-dev-only

# --- API process (not in demo.yaml; see deploy/COMPOSE.md, demo-config.md) ---
GEOAICUBES_API_PORT=8000
# GEOAICUBES_API_RELOAD=true
GEOAICUBES_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# GEOAICUBES_LOG_LEVEL=INFO

# =============================================================================
# Viewer (Vite build-time; apps/viewer/.env.example for local bun dev only)
# =============================================================================
VITE_API_BASE_URL=http://localhost:8000